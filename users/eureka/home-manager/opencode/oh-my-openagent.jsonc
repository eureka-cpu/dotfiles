{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "telemetry": false,
  "team_mode": {
    "enabled": true,
    "max_members": 4,
    "wall_clock_timeout_minutes": 60
  },
  "agents": {
    "sisyphus":  { "model": "ollama/qwen3:30b" },
    "prometheus": { "model": "ollama/qwen3:30b" },
    "atlas":     { "model": "ollama/qwen3:30b" }
  },
  "categories": {
    "ultrabrain": { "model": "ollama/qwen3:30b" },
    "deep":       { "model": "ollama/qwen3:30b" },
    "quick":      { "model": "ollama/qwen2.5-coder:14b" }
  }
}
